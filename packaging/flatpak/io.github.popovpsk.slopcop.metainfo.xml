<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.popovpsk.slopcop</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <name>Slopcop</name>
  <summary>Side-by-side diff reviewer for huge merge requests</summary>

  <developer id="io.github.popovpsk">
    <name>Aleksandr Popov</name>
  </developer>

  <description>
    <p>
      Slopcop is a native side-by-side diff reviewer for huge merge requests, built in
      Rust. It tracks per-file "viewed" progress so a long review can be picked up where it
      was left.
    </p>
  </description>

  <launchable type="desktop-id">io.github.popovpsk.slopcop.desktop</launchable>

  <url type="homepage">https://github.com/popovpsk/slopcop</url>
  <url type="bugtracker">https://github.com/popovpsk/slopcop/issues</url>
  <url type="vcs-browser">https://github.com/popovpsk/slopcop</url>

  <categories>
    <category>Development</category>
    <category>RevisionControl</category>
  </categories>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>

  <requires>
    <display_length compare="ge">768</display_length>
  </requires>

  <branding>
    <color type="primary" scheme_preference="light">#e8e6e3</color>
    <color type="primary" scheme_preference="dark">#1c1b1a</color>
  </branding>

  <content_rating type="oars-1.1" />

  <releases>
  </releases>
</component>
